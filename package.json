{
  "name": "vitae",
  "version": "0.1.0",
  "description": "Build resume variants as .docx files from typed content.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vitae": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "link": "npm run build && npm link",
    "unlink": "npm unlink -g vitae",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.32.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "docx": "^9.7.1",
    "jiti": "^2.7.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.4.3"
  }
}
